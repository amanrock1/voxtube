# Server Environment Variables
PORT=5000

# Supabase Credentials (from your Supabase Dashboard settings)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here (important: use the service_role key, not anon key)

# Gemini API Key (from Google AI Studio - completely free)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Developer API Key (for YouTube Data API v3 - free)
YOUTUBE_API_KEY=your_youtube_api_key_here

# (Optional) Your deployed frontend URL — required for CORS in production
# Example: https://voxtube.vercel.app
FRONTEND_URL=

# Cloudflare Turnstile CAPTCHA Keys (for bot protection)
# Dummy testing secret key that always passes (use with VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA)
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA